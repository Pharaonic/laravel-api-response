{
  "name": "pharaonic/laravel-api-response",
  "description": "Consistent Laravel API responses: one envelope for success and error responses, resources and every paginator, with profiles, notifications, request IDs and opt-in exception rendering.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "api",
    "api response",
    "json",
    "json response",
    "envelope",
    "pagination",
    "resources",
    "exceptions",
    "request id"
  ],
  "homepage": "https://pharaonic.dev/packages/laravel/api-response",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/api-response",
    "issues": "https://github.com/Pharaonic/laravel-api-response/issues",
    "source": "https://github.com/Pharaonic/laravel-api-response"
  },
  "require": {
    "php": ">=8.0 <8.2",
    "illuminate/container": "^8.75",
    "illuminate/contracts": "^8.75",
    "illuminate/http": "^8.75",
    "illuminate/pagination": "^8.75",
    "illuminate/support": "^8.75"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^6.25",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "suggest": {
    "pharaonic/laravel-seo": "Adds the page's SEO tags to a response that calls withSEO() (8.1 or later)."
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiResponse\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\ApiResponse\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\ApiResponse\\ApiResponseServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 8; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 8; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
